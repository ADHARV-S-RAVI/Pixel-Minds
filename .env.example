# ==============================================================================
# Pixel Minds — Environment Configuration
# ==============================================================================

# Frontend Supabase Configuration (Vite)
# Required for user authentication, database operations, and real-time subscriptions.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Optional alias for publishable key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Serverless Functions Supabase Configuration (Vercel API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application URL
APP_URL=https://pixelminds.tech

# Serverless Email Service (SMTP / Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info.pixellminds@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Pixel Minds" <info.pixellminds@gmail.com>
