# ==============================================================================
# Pixel Minds - Environment Variables Template
# ==============================================================================
# Copy this file to '.env' and populate with your own project configuration.
# Never commit real secrets, private keys, or service-role keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Client Configuration (Required for Frontend)
# ------------------------------------------------------------------------------
# Obtain these from your Supabase Dashboard: Project Settings -> API
# VITE_SUPABASE_URL: Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# VITE_SUPABASE_PUBLISHABLE_KEY: The public anon/publishable key safe for client-side browsers.
# NEVER place your Supabase service_role key here!
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Optional alternative variable name for the Supabase anonymous key
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 2. Transactional Email Service (Optional - for /api/send-email notifications)
# ------------------------------------------------------------------------------
# Configured in your Vercel Project Environment Variables if running the serverless function.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-secure-app-password
SMTP_FROM="Pixel Minds <your-email@example.com>"

# ------------------------------------------------------------------------------
# 3. Legacy Firebase Configuration (Optional / Phased Deprecation)
# ------------------------------------------------------------------------------
# Used only if legacy fallback services are active in your environment.
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
